{
	"name": "@jmoak/chrono-mcp",
	"version": "0.4.2",
	"private": false,
	"type": "module",
	"description": "MCP server for time math at scale — RFC 9557 (IXDTF) interchange, DST-correct RRULE expansion, 100k-item batch stats, and a temporal context envelope on every response",
	"bin": {
		"chrono-mcp": "dist/cli.js"
	},
	"main": "dist/index.js",
	"module": "src/index.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"API.md",
		"SECURITY.md",
		"CODE_OF_CONDUCT.md",
		"CONTRIBUTING.md",
		"docs",
		"examples"
	],
	"keywords": [
		"mcp-server",
		"model-context-protocol",
		"time",
		"timezone",
		"date",
		"datetime",
		"calendar",
		"rrule",
		"recurrence",
		"ixdtf",
		"rfc-9557",
		"rfc-5545",
		"batch",
		"luxon"
	],
	"author": "Jordan Moak",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/JMoak/chrono-mcp.git"
	},
	"homepage": "https://github.com/JMoak/chrono-mcp#readme",
	"bugs": {
		"url": "https://github.com/JMoak/chrono-mcp/issues"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rimraf dist",
		"lint": "biome lint .",
		"lint:fix": "biome check --write --unsafe .",
		"inspector": "npx @modelcontextprotocol/inspector --config .mcp.json --profile chrono-mcp",
		"test": "vitest run",
		"test:ui": "vitest run --ui",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench --run",
		"start:http": "node -e \"process.env.MCP_TRANSPORT='http'; process.env.PORT='8000'; require('./dist/cli.js')\"",
		"test:mcp": "vib-test run",
		"contracts:emit": "tdd-dsl emit --target vibrissa --out-dir tests/integration/vibrissa/cases tests/contracts/get-time.tdd tests/contracts/envelope.tdd tests/contracts/ixdtf.tdd tests/contracts/expand.tdd tests/contracts/isolation.tdd tests/contracts/core-ops.tdd"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@types/luxon": "^3.7.2",
		"luxon": "^3.7.2",
		"rrule-temporal": "^2.0.2",
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@jmoak/vibrissa": "^0.1.0",
		"@types/node": "^24.3.3",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
