{
  "name": "add preserves wall clock across dst",
  "tool": "TIME CALCULATOR",
  "args": {
    "operation": "add",
    "base_time": "2026-03-07T09:00:00",
    "timezone": "America/New_York",
    "days": 1
  },
  "expect": {
    "$partial": true,
    "content": [
      {
        "type": "text",
        "text": { "$regex": "\"result\": \"2026-03-08T09:00:00\\.000-04:00\"[\\s\\S]*\"result_timezone\": \"America/New_York\"" }
      }
    ]
  }
}
