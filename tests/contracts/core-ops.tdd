suite "chrono-mcp core operations protocol"
target vibrissa "chrono-mcp"

case "adds duration to utc datetime":
  given input:
    {
      "operation": "add",
      "base_time": "2024-12-25T10:00:00Z",
      "timezone": "UTC",
      "days": 5,
      "hours": 3
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "\"result\": \"2024-12-30T13:00:00\\.000Z\"[\\s\\S]*\"result_timezone\": \"UTC\"" }
        }
      ]
    }

case "add preserves wall clock across dst":
  given input:
    {
      "operation": "add",
      "base_time": "2026-03-07T09:00:00",
      "timezone": "America/New_York",
      "days": 1
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "\"result\": \"2026-03-08T09:00:00\\.000-04:00\"[\\s\\S]*\"result_timezone\": \"America/New_York\"" }
        }
      ]
    }

case "diff decomposes time difference":
  given input:
    {
      "operation": "diff",
      "base_time": "2024-01-01T00:00:00Z",
      "compare_time": "2024-01-02T03:04:05Z"
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "\"days\": 1[\\s\\S]*\"hours\": 3[\\s\\S]*\"minutes\": 4[\\s\\S]*\"seconds\": 5[\\s\\S]*\"total_milliseconds\": 97445000" }
        }
      ]
    }

case "duration between reports calendar breakdown":
  given input:
    {
      "operation": "duration_between",
      "base_time": "2024-01-15T00:00:00Z",
      "compare_time": "2026-03-20T06:30:00Z"
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "\"years\": 2[\\s\\S]*\"months\": 2[\\s\\S]*\"days\": 5[\\s\\S]*\"hours\": 6[\\s\\S]*\"minutes\": 30[\\s\\S]*\"human_readable\"" }
        }
      ]
    }

case "pairwise diff batches results":
  given input:
    {
      "operation": "diff",
      "interaction_mode": "pairwise",
      "base_time": ["2024-01-01T00:00:00Z", "2024-06-01T00:00:00Z"],
      "compare_time": ["2024-01-02T00:00:00Z", "2024-06-03T00:00:00Z"]
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "\"count\": 2[\\s\\S]*\"total_milliseconds\": 86400000[\\s\\S]*\"total_milliseconds\": 172800000[\\s\\S]*\"interaction_mode\": \"pairwise\"" }
        }
      ]
    }
