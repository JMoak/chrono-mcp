suite "chrono-mcp expand operation protocol"
target vibrissa "chrono-mcp"

case "expands weekly rrule across dst transition":
  given input:
    {
      "operation": "expand",
      "recurrence": "DTSTART;TZID=America/New_York:20260224T090000\nRRULE:FREQ=WEEKLY;BYDAY=TU;COUNT=4",
      "occurrence_format": "ixdtf"
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "2026-03-03T09:00:00\\.000-05:00\\[America/New_York\\][\\s\\S]*2026-03-10T09:00:00\\.000-04:00\\[America/New_York\\]" }
        }
      ]
    }

case "expands iso repeating interval":
  given input:
    {
      "operation": "expand",
      "recurrence": "R3/2026-03-01T14:00:00Z/P1D"
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "\"count\": 3[\\s\\S]*\"2026-03-02T14:00:00\\.000Z\"" }
        }
      ]
    }

case "reports truncation on unbounded rules":
  given input:
    {
      "operation": "expand",
      "recurrence": "FREQ=DAILY",
      "base_time": "2026-01-01T09:00:00Z",
      "max_occurrences": 5
    }
  when call "TIME CALCULATOR"
  then equals:
    {
      "$partial": true,
      "content": [
        {
          "type": "text",
          "text": { "$regex": "\"count\": 5[\\s\\S]*\"truncated\": true" }
        }
      ]
    }
